{
  "testName": "Restaurant Menu App - Comet Browser Testing",
  "baseUrl": "http://localhost:3001",
  "description": "End-to-end testing for restaurant menu application",
  
  "testCases": [
    {
      "name": "Customer Menu Experience",
      "steps": [
        {
          "action": "Open homepage",
          "url": "http://localhost:3001",
          "check": "Page loads with menu items visible"
        },
        {
          "action": "Switch language to Hindi",
          "check": "Menu items display in Hindi"
        },
        {
          "action": "Switch language to Telugu", 
          "check": "Menu items display in Telugu"
        },
        {
          "action": "Click on 'Biryani' category",
          "check": "Only biryani items are shown"
        },
        {
          "action": "Add 3 items to cart",
          "check": "Cart icon shows count of 3"
        },
        {
          "action": "Open cart drawer",
          "check": "Cart shows 3 items with correct totals"
        },
        {
          "action": "Proceed to checkout",
          "check": "Checkout form loads"
        },
        {
          "action": "Fill checkout form and submit",
          "data": {
            "name": "Test Customer",
            "phone": "9876543210", 
            "tableNumber": "5",
            "paymentMethod": "cash"
          },
          "check": "Order confirmation appears"
        }
      ]
    },
    {
      "name": "Admin Dashboard",
      "steps": [
        {
          "action": "Go to admin login",
          "url": "http://localhost:3001/admin/login",
          "check": "Login form is visible"
        },
        {
          "action": "Login with admin credentials",
          "data": {
            "email": "admin@srikanya.com",
            "password": "admin123"
          },
          "check": "Redirected to admin dashboard"
        },
        {
          "action": "Click 'Add New Item'",
          "check": "Add item modal opens"
        },
        {
          "action": "Fill item details and upload image",
          "data": {
            "name": "Test Item",
            "description": "Test description",
            "price": "150",
            "category": "Curries"
          },
          "check": "Item is created successfully"
        },
        {
          "action": "Edit an existing item",
          "check": "Item details can be modified"
        },
        {
          "action": "Check order management",
          "check": "Orders are visible and can be updated"
        },
        {
          "action": "View analytics dashboard",
          "check": "Analytics data is displayed"
        }
      ]
    },
    {
      "name": "PWA Features",
      "steps": [
        {
          "action": "Check if install prompt appears",
          "check": "Add to home screen option available"
        },
        {
          "action": "Test offline functionality",
          "check": "App works without internet"
        },
        {
          "action": "Check service worker",
          "check": "Service worker is registered"
        }
      ]
    },
    {
      "name": "Performance Testing",
      "steps": [
        {
          "action": "Measure page load time",
          "check": "Page loads within 3 seconds"
        },
        {
          "action": "Test responsive design",
          "check": "App works on mobile and desktop"
        },
        {
          "action": "Test search functionality",
          "check": "Search works quickly and accurately"
        }
      ]
    }
  ],
  
  "testData": {
    "customer": {
      "name": "Test Customer",
      "phone": "9876543210",
      "tableNumber": "5",
      "email": "test@example.com"
    },
    "admin": {
      "email": "admin@srikanya.com", 
      "password": "admin123"
    }
  },
  
  "performanceTargets": {
    "pageLoad": "< 3s",
    "imageLoad": "< 2s", 
    "cartResponse": "< 1s",
    "searchResponse": "< 500ms"
  }
}
