# Database Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Vector Search Provider Configuration (Choose one or multiple)
# OpenAI (Most Reliable)
OPENAI_API_KEY=

# Groq (Fastest & Cost-Effective)
GROQ_API_KEY=

# Google Gemini (Free Tier Available)
GEMINI_API_KEY=

# OpenRouter (Multiple Models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=
EMAIL_SECURE=false

# Admin Configuration
ADMIN_EMAIL=
KITCHEN_EMAIL=

# Cloudinary Configuration (Required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Webhook Configuration (Optional)
WEBHOOK_URL=your_webhook_url_here

# JWT Secret (Required for admin authentication)
JWT_SECRET=your_jwt_secret_here

# N8N Webhook URL (optional, legacy)
N8N_WEBHOOK_URL=

# Admin Password (change this!)
ADMIN_PASSWORD=srikanya2024

# Vector Search Configuration (Optional)
VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_MODEL=text-embedding-3-small
VECTOR_SEARCH_DIMENSIONS=1536
VECTOR_SEARCH_BATCH_SIZE=10

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:3000 
